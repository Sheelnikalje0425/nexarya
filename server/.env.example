# ==============================================================================
# NEXARYA CORE SERVER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide appropriate deployment values.
# NEVER commit real credentials or .env files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE APPLICATION ENVIRONMENT (REQUIRED)
# ------------------------------------------------------------------------------
# Node runtime environment ('development' | 'production')
NODE_ENV=production

# Secret key for HMAC-SHA256 JWT signature generation and token verification.
# In production, use a high-entropy string (minimum 64 characters).
JWT_SECRET=your_production_jwt_secret_64_characters_min_change_me

# Initial administrative account bootstrap password.
# Used ONLY on initial database creation. Changes persist across server restarts.
ADMIN_DEFAULT_PASSWORD=your_initial_admin_bootstrap_password_change_me

# Port on which the Express REST API backend listens.
PORT=5000

# Permitted CORS Origin(s).
# In production, specify the exact domain(s) permitted to make API calls (comma-separated if multiple).
CORS_ORIGIN=https://nexarya.in

# ------------------------------------------------------------------------------
# TRANSACTIONAL EMAIL NOTIFICATIONS (RECOMMENDED / CONDITIONAL)
# If unconfigured, the system automatically logs transactional emails to console mock.
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.nexarya.in
SMTP_PASS=your_smtp_password_here
ADMIN_NOTIFICATION_EMAIL=leads@nexarya.in

# ------------------------------------------------------------------------------
# STRIPE PAYMENTS & MILESTONE DEPOSITS (CONDITIONAL / NOT REQUIRED FOR V1)
# Online payment processing is disabled by default for v1 studio inquiry workflow.
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_placeholder
PAYMENT_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_placeholder
