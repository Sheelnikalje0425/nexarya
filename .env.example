# ==============================================================================
# NEXARYA PRODUCTION ENVIRONMENT CONFIGURATION CONTRACT (.env.example)
# ==============================================================================
# Copy this file to .env and provide genuine secrets prior to running the server.
# Never commit .env or real secrets to source control.
# ==============================================================================

# Server Runtime Environment
NODE_ENV=production
PORT=5000

# Authentication & Session Security (Required in Production: min 32 characters)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars

# Administrator Initial Setup (Required in Production when running seed.ts)
ADMIN_DEFAULT_PASSWORD=replace_with_a_secure_initial_admin_password

# Stripe / Payment Processing Gateway (Required in Production for transactions)
STRIPE_SECRET_KEY=sk_live_replace_with_your_stripe_secret_key
PAYMENT_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_endpoint_secret

# Lead Alerting & Email Dispatch (Optional: falls back to standard log dispatch if empty)
ADMIN_NOTIFICATION_EMAIL=leads@nexarya.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nexarya Engineering <hello@nexarya.in>"
